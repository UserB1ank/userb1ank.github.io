{{- $.Scratch.Set "categories" slice -}}
{{- range .Site.Home.RegularPages -}}
  {{- $cat := .Params.category -}}
  {{- if not $cat -}}{{- with .Params.categories -}}{{- $cat = index . 0 -}}{{- end -}}{{- end -}}
  {{- with $cat -}}
    {{- $found := false -}}
    {{- range $.Scratch.GetSortedMapValues "categories" -}}
      {{- if eq .name $cat -}}
        {{- $found = true -}}
      {{- end -}}
    {{- end -}}
    {{- if not $found -}}
      {{- $count := 0 -}}
      {{- range $.Site.RegularPages -}}
        {{- $pc := .Params.category -}}
        {{- if not $pc -}}{{- with .Params.categories -}}{{- $pc = index . 0 -}}{{- end -}}{{- end -}}
        {{- if eq $pc $cat -}}{{- $count = add $count 1 -}}{{- end -}}
      {{- end -}}
      {{- $.Scratch.Add "categories" (dict "name" $cat "count" $count) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $.Scratch.Get "categories" | jsonify -}}
