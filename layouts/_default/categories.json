{{- $categories := slice -}}
{{- $categoryMap := dict -}}
{{- range .Site.RegularPages -}}
  {{- $cat := .Params.category -}}
  {{- if not $cat -}}{{- with .Params.categories -}}{{- $cat = index . 0 -}}{{- end -}}{{- end -}}
  {{- with $cat -}}
    {{- if index $categoryMap . -}}
      {{- $count := add (index $categoryMap .) 1 -}}
      {{- $categoryMap = merge $categoryMap (dict . $count) -}}
    {{- else -}}
      {{- $categoryMap = merge $categoryMap (dict . 1) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- range $name, $count := $categoryMap -}}
  {{- $categories = $categories | append (dict "name" $name "count" $count) -}}
{{- end -}}
{{- $categories | jsonify -}}
